# ============================================================================
# SENDGRID EMAIL CONFIGURATION
# ============================================================================
# IMPORTANT: Replace with your actual SendGrid API key!
# Get it from: https://app.sendgrid.com/settings/api_keys

SENDGRID_API_KEY=your-sendgrid-api-key

# ============================================================================
# EMAIL RETRY SETTINGS (Optional - defaults shown)
# ============================================================================
EMAIL_SEND_RETRIES=3
EMAIL_RETRY_DELAY_SECONDS=2
SENDGRID_MAX_RETRIES=3

# ============================================================================
# SENDER EMAIL CONFIGURATION
# ============================================================================
# Must be the exact verified sender in the SendGrid dashboard.
# If this does not match a verified SendGrid Single Sender or authenticated
# domain address, OTP emails will fail with HTTP 403.
# Options:
# 1. Verified domain (e.g., noreply@mishra-consultancy.com)
# 2. Verified sender email (e.g., support@yourcompany.com)
DEFAULT_FROM_EMAIL=your-verified-sendgrid-sender@example.com
SENDGRID_FROM_EMAIL=your-verified-sendgrid-sender@example.com
SENDGRID_FROM_NAME=Mishra Consultancy
# ============================================================================
# DJANGO CORE SETTINGS
# ============================================================================
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# For production, use PostgreSQL instead of SQLite
DATABASE_URL=sqlite:///db.sqlite3

# ============================================================================
# REDIS & CELERY CONFIGURATION (For async emails)
# ============================================================================
# Redis is used for Celery task queue
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# ============================================================================
# SECURITY SETTINGS
# ============================================================================
SECURE_SSL_REDIRECT=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# ============================================================================
# DEPLOYMENT PLATFORMS
# ============================================================================
# For Render.com:
# RENDER_EXTERNAL_URL=https://yourdomain.onrender.com

# For Heroku:
# HEROKU_API_KEY=your-heroku-api-key

# ============================================================================
# ADMIN CONFIGURATION
# ============================================================================
# Admin email addresses for notifications
ADMIN_EMAIL_1=xyz@gmail.com
ADMIN_EMAIL_2=xyz2@gmail.com

# ============================================================================
# NOTES
# ============================================================================
# 1. Replace the placeholder with your actual SendGrid API key
# 2. Ensure DEFAULT_FROM_EMAIL or SENDGRID_FROM_EMAIL is verified in SendGrid
# 3. Keep this file in .gitignore - NEVER commit credentials
# 4. Update all variables according to your environment
# 5. Reload your application after changes to this file
# 6. In production, set these variables on your deployment platform
#    (Render Environment Variables, Heroku Config Vars, etc.)

# For Render.com environment variables, go to:
# Dashboard → Your Project → Settings → Environment Variables
# Then add each variable from this file

# To use python-dotenv for local development, install:
# pip install python-dotenv
# Then in your settings.py or manage.py, load variables:
# from dotenv import load_dotenv
# load_dotenv()
